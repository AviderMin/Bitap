# Keep evaluation corpus byte-identical across checkouts: manifest SHA-256 values
# are computed from LF-encoded files and the checker must pass on every clone.
eval/v2/corpus/*.tsv text eol=lf
eval/v2/corpus/*.json text eol=lf
eval/v2/corpus/*.py text eol=lf
eval/v2/corpus/*.md text eol=lf
eval/v2/events/*.jsonl text eol=lf
eval/v2/events/*.md text eol=lf
eval/v2/*.py text eol=lf
eval/v3/corpus/*.tsv text eol=lf
eval/v3/corpus/*.json text eol=lf
eval/v3/corpus/*.py text eol=lf
eval/v3/corpus/*.md text eol=lf
eval/v3/*.py text eol=lf
eval/d04/results/*.json text eol=lf
eval/d04/same_dictionary/*.json text eol=lf
eval/d04/same_dictionary/*.py text eol=lf
eval/d05/dev/*.tsv text eol=lf
eval/d05/dev/*.json text eol=lf
eval/d05/dev/*.py text eol=lf
eval/d05/dev/*.md text eol=lf
